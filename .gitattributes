# ============================================================
#  换行符统一：仓库内一律 LF，避免 Windows / Linux 之间的 CRLF 噪声
# ============================================================
* text=auto eol=lf

# ---------------- 明确按文本处理 ----------------
*.py    text
*.js    text
*.css   text
*.html  text
*.md    text
*.csv   text
*.json  text
*.txt   text
*.gitignore      text
*.gitattributes  text

# ---------------- 二进制文件：绝不转换 ----------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.pptx  binary

# ---------------- 第三方资源 ----------------
